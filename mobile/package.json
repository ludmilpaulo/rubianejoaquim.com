{
  "name": "mobile",
  "version": "1.0.10",
  "main": "index.ts",
  "scripts": {
    "version:bump": "node scripts/bump-version.js",
    "build": "npm run version:bump && eas build --local",
    "build:production": "npm run version:bump && eas build --profile production --local",
    "build:preview": "npm run version:bump && eas build --profile preview --local",
    "build:production:local": "eas build --profile production --local",
    "update:production": "eas update --branch production --message \"Production update\"",
    "update:preview": "eas update --branch preview --message \"Preview update\"",
    "update:development": "eas update --branch development --message \"Development update\"",
    "submit:production": "eas submit --profile production --platform all",
    "submit:ios": "eas submit --profile production --platform ios",
    "submit:android": "eas submit --profile production --platform android",
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start",
    "start:localhost": "EXPO_USE_LOCALHOST=1 expo start",
    "android": "expo run:android",
    "ios": "EXPO_USE_LOCALHOST=1 expo start --ios",
    "ios:manual": "EXPO_USE_LOCALHOST=1 expo start --localhost",
    "ios:network": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "i18n:check": "python ../scripts/check_i18n_keys.py",
    "test:api": "node scripts/smoke-test-api.mjs",
    "e2e:prep": "node scripts/e2e-prep.mjs",
    "test:web": "playwright test",
    "test:web:ui": "playwright test --ui",
    "test:web:headed": "playwright test --headed",
    "test:e2e": "maestro test .maestro/app-smoke-dev.yaml",
    "test:e2e:login": "maestro test .maestro/login-standalone.yaml"
  },
  "dependencies": {
    "@babel/helper-module-imports": "^7.29.7",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.6.16",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.2",
    "babel-preset-expo": "~54.0.12",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^15.3.2",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "^13.15.0",
    "react-native-youtube-iframe": "^2.4.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "~19.1.0",
    "eas-cli": "^16.32.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
