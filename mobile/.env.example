# Copy to .env and adjust for local development
# Production API (default in app if unset on physical device / release builds)
EXPO_PUBLIC_API_URL=https://ludmilpaulo.pythonanywhere.com/api

# Local backend — set EXPO_PUBLIC_USE_DEV_API=true when testing against runserver
EXPO_PUBLIC_USE_DEV_API=false
EXPO_PUBLIC_DEV_API_HOST=192.168.1.100
EXPO_PUBLIC_DEV_API_PORT=8000

# Social login — public client IDs only (never put provider secrets in the app)
# Production builds bake these via eas.json; also served from GET /api/auth/social/config/
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=112065604009-sc5vf5kgoak181brsategi76po9mv6fq.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=112065604009-bt1io2ogtdl5focg0r25i2stg1sln4co.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=112065604009-r84rff44o3acsrcmlmiihmiadvcd23jn.apps.googleusercontent.com
# EXPO_PUBLIC_FACEBOOK_APP_ID=2691305731001778
# Meta Client Token (Settings → Advanced). Public. Required by the native Facebook SDK.
# EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=ea2135093dfbbefd2f81b36f6d34df2f
