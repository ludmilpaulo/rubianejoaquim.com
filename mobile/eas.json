{
  "cli": {
    "version": ">= 16.6.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_USE_DEV_API": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ludmilpaulo.pythonanywhere.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ludmilpaulo.pythonanywhere.com/api"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleId": "ludmilpaulo@gmail.com",
        "ascAppId": "6758412176",
        "appleTeamId": "WF3T257QTW"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleId": "ludmilpaulo@gmail.com",
        "ascAppId": "6758412176",
        "appleTeamId": "WF3T257QTW",
        "sku": "com.rubianejoaquim.zenda"
      }
    }
  }
}
