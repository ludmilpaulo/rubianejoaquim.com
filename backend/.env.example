# Django - Production (PythonAnywhere)
# Copy to .env and fill real values. Never commit .env.

DEBUG=False
SECRET_KEY=your-secret-key-here

# Hosts (comma-separated)
ALLOWED_HOSTS=ludmilpaulo.pythonanywhere.com

# CORS - frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://www.rubianejoaquim.com,https://rubianejoaquim.com

# Frontend URL (emails, redirects)
FRONTEND_URL=https://www.rubianejoaquim.com

# Wallet — keep False until licensed provider contract signed
WALLET_LIVE_ENABLED=False
RECEIPT_SIGNED_URL_MAX_AGE=3600
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: Email (SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Rubiane Joaquim <noreply@rubianejoaquim.com>

# Optional: Zenda app store update check (bump when you publish a new version)
# Keep APP_MINIMUM_VERSION_* <= currently shipped store version until 1.0.9 is live.
# APP_LATEST_VERSION_IOS=1.0.9
# APP_LATEST_VERSION_ANDROID=1.0.9
# APP_MINIMUM_VERSION_IOS=1.0.0
# APP_MINIMUM_VERSION_ANDROID=1.0.0
# APP_FORCE_UPDATE=False
# APP_STORE_URL_IOS=https://apps.apple.com/app/id6758412176
# APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.rubianejoaquim.zenda

# Subscription reminders — Push (Expo) + SMS + WhatsApp
# Push tokens are registered by the Zenda app.
# WhatsApp (free): GREEN-API — https://green-api.com
# 1. Create a free developer instance
# 2. Scan the QR with WhatsApp on +27659031894
# 3. Paste idInstance + apiTokenInstance (and the apiUrl host from the console)
WHATSAPP_PROVIDER_NUMBER=+27659031894
GREEN_API_ID_INSTANCE=
GREEN_API_API_TOKEN=
GREEN_API_URL=https://7107.api.greenapi.com
# Optional paid/official fallbacks (not required if GREEN-API is linked):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+14155550100
# TWILIO_WHATSAPP_FROM=whatsapp:+27659031894
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=zenda_renewal_reminder
# WHATSAPP_TEMPLATE_LANG=pt
# Optional generic gateway (Unitel / other):
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_WEBHOOK_TOKEN=

# Apple In-App Purchase (Guideline 3.1.1) - required for IAP receipt verification
# App Store Connect → Your App → In-App Purchase → App-Specific Shared Secret
# APPLE_SHARED_SECRET=your-app-specific-shared-secret
# APPLE_BUNDLE_ID=com.rubianejoaquim.zenda
# Sign in with Apple (Guideline 4.8 when offering Google/Facebook/TikTok)
# APPLE_SIGN_IN_ENABLED=True
# APPLE_SIGN_IN_AUDIENCES=  # optional comma-separated Services IDs for web

# iKhokha iK Pay API (optional fallbacks — configure in Admin → Settings → Payments)
# Never commit real secrets. Admin UI is preferred over env vars.
# IKHOKHA_APP_ID=
# IKHOKHA_APP_SECRET=
# IKHOKHA_ENVIRONMENT=sandbox
# IKHOKHA_CALLBACK_URL=https://ludmilpaulo.pythonanywhere.com/api/subscriptions/ikhokha/webhook/

# ---------------------------------------------------------------------------
# Social login — use SEPARATE credentials for development vs production.
# Never commit real secrets. Never put CLIENT_SECRET / APP_SECRET in frontend.
# ---------------------------------------------------------------------------
# Public API base used to build TikTok callback if TIKTOK_REDIRECT_URI is empty
API_PUBLIC_URL=https://ludmilpaulo.pythonanywhere.com

# Google Identity Services (OAuth client IDs)
# Web client ID is public (also exposed to frontend via /api/auth/social/config/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional native clients (ID token audience allow-list)
GOOGLE_CLIENT_ID_IOS=
# Comma-separated if Play App Signing and upload key use different Android OAuth clients
GOOGLE_CLIENT_ID_ANDROID=

# Meta Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok Login Kit (authorization-code + PKCE; secrets server-side only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the redirect URI registered in TikTok developer portal
TIKTOK_REDIRECT_URI=https://ludmilpaulo.pythonanywhere.com/api/auth/social/tiktok/callback/
TIKTOK_SCOPES=user.info.basic
MOBILE_OAUTH_REDIRECT_URI=zenda://social-callback

# Live FX (market rates) — see EXCHANGE_RATES.md
# Cron: python manage.py refresh_exchange_rates --force  (every 6h recommended)
# Primary: open.er-api.com (no API key). Fallback: api.frankfurter.app (ECB).
# seed_exchange_rates is emergency bootstrap only — never treat as live truth.
FX_CACHE_TTL_HOURS=6
